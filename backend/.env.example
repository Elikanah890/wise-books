NODE_ENV=development
PORT=8000
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME
JWT_SECRET=replace_with_64_char_hex_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# PayMe Africa (live). APP_ID and SECRET are required — the app refuses to start without them.
PAYME_BASE_URL=https://portal.paymeafrica.com/api/v1
PAYME_APP_ID=WISEBOOK_1
PAYME_SECRET=replace_with_payme_secret
PAYME_CALLBACK_URL=https://api-wisebook.brandtechtz.co.tz/api/payments/payme/callback
PAYME_QUERY_INTERVAL_SECONDS=15
PAYME_QUERY_MAX_ATTEMPTS=40
